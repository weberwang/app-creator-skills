{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "统一工作实施包",
  "description": "引用栈专用验证标准，不将 Unity 资产规则强制套用于其他栈。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workItemId", "stack", "workItemType", "executionUnits", "systemCoverage"],
  "properties": {
    "systemCoverage": {"$ref": "https://app-creator-skills.local/app-workflow-control/system-coverage.schema.json"},
    "schemaVersion": {"const": "1.0"},
    "workItemId": {"type": "string", "minLength": 1},
    "stack": {"enum": ["unity", "cocos", "phaser", "threejs", "flutter", "expo", "esp32", "nodejs", "roblox"]},
    "workItemType": {"enum": ["PROJECT", "FOUNDATION", "MODULE", "SCENE", "PAGE", "DISPLAY_LAYER", "INTEGRATION", "RELEASE"]},
    "visualStage": {"enum": ["V1", "V2", "V3", "V4", "V5"]},
    "productionScopeRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "productionBatchId": {"type": "string", "minLength": 1},
    "productionDependencies": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["batchId", "workItemRef"], "properties": {"batchId": {"type": "string", "minLength": 1}, "workItemRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}}},
    "executionUnits": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["unitId", "sequence", "type", "owner", "paths", "resultPath", "acceptanceCommands"], "properties": {"unitId": {"type": "string", "minLength": 1}, "sequence": {"type": "integer", "minimum": 1}, "type": {"enum": ["SHARED", "MODULE", "SCENE", "PAGE", "DISPLAY_LAYER", "INTEGRATION", "RELEASE"]}, "owner": {"type": "string", "minLength": 1}, "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "resultPath": {"type": "string", "minLength": 1}, "acceptanceCommands": {"type": "array", "minItems": 1, "items": {"type":"string","minLength":1,"pattern":"^(?!\\s*(?:<[^>\\r\\n]+>|[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd]|待填写|待执行|待运行|待补充|占位命令)\\s*$)(?![\\s\\S]*<(?:执行|运行|填写|替换|实际|真实|必须|检查|命令|command|cmd|check|test|path|file)[^>\\r\\n]*>)[\\s\\S]*\\S[\\s\\S]*$"}}, "parallelGroup": {"type": "string", "minLength": 1}, "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "sampleRole": {"enum": ["sample", "batch"]}, "sampleScopeIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "sampleBasisRef": {"$ref": "#/$defs/frozenRef"}, "sampleDecisionRequired": {"type": "boolean"}}, "dependentRequired": {"sampleRole": ["sampleScopeIds", "sampleBasisRef"], "sampleScopeIds": ["sampleRole"], "sampleBasisRef": ["sampleRole"], "sampleDecisionRequired": ["sampleRole"]}, "allOf": [{"if": {"required": ["sampleRole"], "properties": {"sampleRole": {"const": "sample"}}}, "then": {"properties": {"sampleDecisionRequired": true}, "required": ["sampleDecisionRequired"]}}, {"if": {"required": ["sampleRole"], "properties": {"sampleRole": {"const": "batch"}}}, "then": {"not": {"properties": {"sampleDecisionRequired": true}, "required": ["sampleDecisionRequired"]}}}]}}
  },
  "$defs": {"frozenRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
}
