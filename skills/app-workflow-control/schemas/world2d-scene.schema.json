{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "world2d-scene.schema.json",
  "title": "2D 世界场景设计依据",
  "description": "引用同一套空间方案、布局运行及既有人工审查确认；结构合法不代表真实运行或视觉验收通过。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "designRoute", "workItemId", "projectId", "stack", "objectId", "scopeIds", "spatialSpecRef", "layoutRef"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "designRoute": { "const": "world-2d" },
    "workItemId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "stack": { "enum": ["unity", "cocos", "phaser", "threejs", "roblox"] },
    "objectId": { "type": "string", "minLength": 1 },
    "scopeIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "spatialSpecRef": { "$ref": "#/$defs/frozenRef" },
    "layoutRef": { "$ref": "#/$defs/frozenRef" },
    "layoutRunRef": { "$ref": "#/$defs/frozenRef" },
    "reviewRef": { "$ref": "#/$defs/frozenRef" },
    "spaceApprovalRef": { "$ref": "#/$defs/frozenRef" }
  },
  "$defs": {
    "frozenRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
