{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "可跨同项目同技术栈工作项复用的视觉基线",
  "description": "图片游戏保留三候选；Figma保持选稿流程；world-3d以冻结方向规格和真实人工选择交接。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "baselineId",
    "projectId",
    "stack",
    "selectionReviewRef"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "baselineId": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "stack": {
      "enum": [
        "unity",
        "cocos",
        "phaser",
        "threejs",
        "flutter",
        "expo",
        "esp32",
        "nodejs",
        "roblox"
      ]
    },
    "selectedCandidateId": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidateId",
          "path",
          "qualityChecks"
        ],
        "properties": {
          "candidateId": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "qualityChecks": {
            "$ref": "human-review.schema.json#/properties/qualityChecks"
          },
          "figmaSnapshotRef": {
            "$ref": "work-item.schema.json#/$defs/visualFileIdentity"
          },
          "visualSourceRef": {
            "$ref": "work-item.schema.json#/$defs/visualFileIdentity"
          },
          "directionSourceRef": {
            "$ref": "work-item.schema.json#/$defs/visualFileIdentity"
          }
        }
      }
    },
    "selectionReviewRef": {
      "$ref": "work-item.schema.json#/$defs/visualFileIdentity"
    },
    "designRoute": {
      "enum": [
        "figma-app",
        "world-3d"
      ]
    },
    "exploration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "initial",
            "redesign",
            "increment"
          ]
        },
        "requestedCount": {
          "type": "integer",
          "minimum": 1
        },
        "userMessageRef": {
          "type": "string",
          "minLength": 1
        },
        "sourceBaselineRef": {
          "$ref": "work-item.schema.json#/$defs/visualFileIdentity"
        },
        "changeScope": {
          "const": "local"
        },
        "changeReason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "combination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "path",
        "qualityChecks",
        "sourceCandidateIds",
        "userMessageRef"
      ],
      "properties": {
        "candidateId": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "qualityChecks": {
          "$ref": "human-review.schema.json#/properties/qualityChecks"
        },
        "figmaSnapshotRef": {
          "$ref": "work-item.schema.json#/$defs/visualFileIdentity"
        },
        "visualSourceRef": {
          "$ref": "work-item.schema.json#/$defs/visualFileIdentity"
        },
        "sourceCandidateIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "userMessageRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "directionRef": {
      "$ref": "work-item.schema.json#/$defs/visualFileIdentity"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "designRoute"
        ],
        "properties": {
          "designRoute": {
            "const": "world-3d"
          }
        }
      },
      "then": {
        "required": [
          "directionRef"
        ],
        "properties": {
          "stack": {
            "enum": [
              "unity",
              "cocos",
              "phaser",
              "threejs",
              "roblox"
            ]
          },
          "candidates": false,
          "selectedCandidateId": false,
          "exploration": false,
          "combination": false
        }
      },
      "else": {
        "required": [
          "candidates",
          "selectedCandidateId"
        ],
        "properties": {
          "directionRef": false
        },
        "allOf": [
          {
            "if": {
              "required": [
                "designRoute"
              ],
              "properties": {
                "designRoute": {
                  "const": "figma-app"
                }
              }
            },
            "then": {
              "required": [
                "exploration"
              ],
              "properties": {
                "stack": {
                  "enum": [
                    "flutter",
                    "expo",
                    "esp32"
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "exploration": {
                        "not": {
                          "required": [
                            "requestedCount"
                          ]
                        }
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "candidates": {
                        "minItems": 1,
                        "maxItems": 1
                      }
                    }
                  }
                }
              ]
            },
            "else": {
              "properties": {
                "candidates": {
                  "minItems": 3,
                  "maxItems": 3
                }
              }
            }
          }
        ]
      }
    }
  ]
}
