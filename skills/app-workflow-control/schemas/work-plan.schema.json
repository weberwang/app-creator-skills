{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-creator-skills.local/app-workflow-control/work-plan.schema.json",
  "title": "工作计划输入",
  "description": "由 Work Item 身份和阶段上下文生成冻结实施包；计划只提供执行单元和可选 F0–F2 自评。",
  "type": "object",
  "additionalProperties": false,
  "required": ["executionUnits"],
  "properties": {
    "executionUnits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unitId", "owner", "paths", "acceptanceCommands"],
        "properties": {
          "unitId": {"type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"},
          "owner": {"type": "string", "minLength": 1},
          "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "acceptanceCommands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "type": {"enum": ["SHARED", "MODULE", "SCENE", "PAGE", "DISPLAY_LAYER", "INTEGRATION", "RELEASE"]},
          "parallelGroup": {"type": "string", "minLength": 1},
          "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "gateAssessments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "F0": {"$ref": "#/$defs/assessment"},
        "F1": {"$ref": "#/$defs/assessment"},
        "F2": {"$ref": "#/$defs/assessment"}
      }
    }
  },
  "$defs": {
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
