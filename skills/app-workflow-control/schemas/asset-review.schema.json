{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "正式素材与人工风格审查",
  "description": "技术导入与用户视觉判断分开记录，支持图片和真实原生组件路线。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workItemId",
    "stack",
    "visualStage",
    "candidateId",
    "technicalStatus",
    "humanStatus",
    "userMessageRef",
    "qualityChecks",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "workItemId": {
      "type": "string"
    },
    "stack": {
      "enum": [
        "unity",
        "cocos",
        "phaser",
        "threejs",
        "flutter",
        "expo",
        "esp32",
        "nodejs",
        "roblox"
      ]
    },
    "visualStage": {
      "const": "V4"
    },
    "candidateId": {
      "type": "string",
      "minLength": 1
    },
    "technicalStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "humanStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "userMessageRef": {
      "type": "string",
      "minLength": 1
    },
    "qualityChecks": {
      "$ref": "human-review.schema.json#/properties/qualityChecks"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "assetId",
          "assetType",
          "output"
        ],
        "properties": {
          "assetId": {
            "type": "string",
            "minLength": 1
          },
          "assetType": {
            "enum": [
              "image",
              "native-component"
            ]
          },
          "output": {
            "type": "string",
            "minLength": 1
          },
          "sourceRef": {
            "type": "string"
          },
          "sourceKind": {
            "enum": [
              "ai-generated",
              "hand-authored",
              "licensed",
              "existing"
            ]
          },
          "generationRecord": {
            "type": "string"
          },
          "antiAiChecks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "PASS",
                    "NOT_APPLICABLE",
                    "FAIL"
                  ]
                },
                "reason": {
                  "type": "string"
                },
                "evidenceRef": {
                  "type": "string"
                }
              }
            }
          },
          "componentEvidenceRef": {
            "type": "string"
          },
          "designItemIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "consumerIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "implementationEvidenceRef": {
            "$ref": "human-review.schema.json#/properties/referenceTarget"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stack": {
            "const": "flutter"
          }
        },
        "required": [
          "stack"
        ]
      },
      "then": {
        "properties": {
          "assets": {
            "items": {
              "required": [
                "designItemIds",
                "consumerIds",
                "implementationEvidenceRef"
              ]
            }
          }
        }
      }
    }
  ]
}
