{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "正式素材与人工风格审查",
  "description": "技术导入与人工视觉判断分开记录；模型资产仅用于显式world-3d场景并绑定真实来源、输出与消费。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workItemId",
    "stack",
    "visualStage",
    "candidateId",
    "technicalStatus",
    "humanStatus",
    "userMessageRef",
    "qualityChecks",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "workItemId": {
      "type": "string"
    },
    "stack": {
      "enum": [
        "unity",
        "cocos",
        "phaser",
        "threejs",
        "flutter",
        "expo",
        "esp32",
        "nodejs",
        "roblox"
      ]
    },
    "visualStage": {
      "const": "V4"
    },
    "candidateId": {
      "type": "string",
      "minLength": 1
    },
    "technicalStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "humanStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "userMessageRef": {
      "type": "string",
      "minLength": 1
    },
    "qualityChecks": {
      "$ref": "human-review.schema.json#/properties/qualityChecks"
    },
    "textRestorationRef": {
      "description": "当前目标 V4 正式图文接入的同批原生回读，含正式入口以及本批图片的实际组件和产物身份",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "assetId",
          "assetType",
          "output"
        ],
        "properties": {
          "assetId": {
            "type": "string",
            "minLength": 1
          },
          "assetType": {
            "enum": [
              "image",
              "native-component",
              "model"
            ]
          },
          "output": {
            "type": "string",
            "minLength": 1
          },
          "sourceRef": {
            "type": "string"
          },
          "sourceKind": {
            "enum": [
              "ai-generated",
              "hand-authored",
              "licensed",
              "existing"
            ]
          },
          "generationRecord": {
            "type": "string"
          },
          "antiAiChecks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "PASS",
                    "NOT_APPLICABLE",
                    "FAIL"
                  ]
                },
                "reason": {
                  "type": "string"
                },
                "evidenceRef": {
                  "type": "string"
                }
              }
            }
          },
          "componentEvidenceRef": {
            "type": "string"
          },
          "designItemIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "consumerIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "implementationEvidenceRef": {
            "$ref": "human-review.schema.json#/properties/referenceTarget"
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "outputSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "importEvidenceRef": {
            "$ref": "work-item.schema.json#/$defs/visualFileIdentity"
          },
          "consumerEvidenceRef": {
            "$ref": "work-item.schema.json#/$defs/visualFileIdentity"
          },
          "generationRecordSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": ["sourceKind"],
              "properties": {"assetType": {"const": "image"}, "sourceKind": {"const": "ai-generated"}}
            },
            "then": {"required": ["sourceRef", "designItemIds", "generationRecord", "generationRecordSha256", "antiAiChecks"]}
          },
          {
            "if": {
              "required": [
                "assetType"
              ],
              "properties": {
                "assetType": {
                  "const": "model"
                }
              }
            },
            "then": {
              "required": [
                "sourceRef",
                "sourceKind",
                "sourceSha256",
                "outputSha256",
                "importEvidenceRef",
                "consumerEvidenceRef"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "sourceKind": {
                        "const": "ai-generated"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "generationRecord",
                      "generationRecordSha256"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "modelSampleRef": {
      "$ref": "work-item.schema.json#/$defs/visualFileIdentity"
    },
    "evidenceRoot": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stack": {
            "const": "flutter"
          }
        },
        "required": [
          "stack"
        ]
      },
      "then": {
        "properties": {
          "assets": {
            "items": {
              "required": [
                "designItemIds",
                "consumerIds",
                "implementationEvidenceRef"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assets": {
            "contains": {
              "required": [
                "assetType"
              ],
              "properties": {
                "assetType": {
                  "const": "model"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "stack": {
            "enum": [
              "unity",
              "cocos",
              "phaser",
              "threejs",
              "roblox"
            ]
          }
        },
        "required": [
          "evidenceRoot"
        ]
      }
    }
  ]
}
