{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phaser4-visual-stage.schema.json",
  "title": "Phaser 4 视觉阶段硬门",
  "type": "object",
  "additionalProperties": false,
  "required": ["visualStageModel", "visualStage", "visualStageState"],
  "properties": {
    "visualStageModel": {"const": "function-first-v1"},
    "visualStage": {"enum": ["V0", "V1", "V2", "V3", "V4", "V5"]},
    "visualStageState": {"enum": ["not-started", "in-progress", "pending", "failed", "stale", "invalid", "global-static-baseline-frozen", "v3-production-planning-complete", "v4-formal-acceptance-complete", "v5-runtime-integration-candidate"]},
    "globalStaticBaselineState": {"const": "global-static-baseline-frozen", "description": "全局静态 visual_baseline 只有在三张候选效果图经唯一人工选择确认后才能冻结；它不代表任一授权场景已完成 V3 拆解方案。"},
    "visual_validation": {"$ref": "#/$defs/visualValidationPolicy", "description": "视觉验收模式；缺省为 usability，exact 必须显式声明。"},
    "globalVisualBaselineSelectionRef": {"$ref": "#/$defs/globalVisualBaselineSelectionReference", "description": "不可变三候选人工选择证据引用；通过 path+sha256 跨 Work Item 复用，冻结状态缺失该引用时必须拒绝。"},
    "visualStageEvidenceRefs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "V3": {"$ref": "#/$defs/evidenceReference"},
        "V4": {"$ref": "#/$defs/evidenceReference"},
        "V5": {"$ref": "#/$defs/evidenceReference"}
      }
    }
  },
  "$defs": {
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"description":"仅作为可选摘要记录，不参与验收或放行。"},
        "workItemId": {"type": "string", "minLength": 1},
        "resultId": {"type": "string", "minLength": 1},
        "unitResultId": {"type": "string", "minLength": 1}
      }
    },
    "globalVisualBaselineSelectionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"description":"仅作为可选摘要记录，不参与验收或放行。"},
        "workItemId": {"type": "string", "minLength": 1, "description": "可选的根证据生产者 Work Item 身份；不是当前消费者 Work Item。"}
      }
    },
    "visualValidationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {"mode": {"enum": ["usability", "exact"]}}
    }
  },
  "allOf": [
    {"if": {"required": ["visualStage"], "properties": {"visualStage": {"const": "V5"}}}, "then": {"required": ["visualStageEvidenceRefs"], "properties": {"visualStageEvidenceRefs": {"required": ["V3", "V4"]}}}},
    {"if": {"required": ["visualStageState"], "properties": {"visualStageState": {"const": "v5-runtime-integration-candidate"}}}, "then": {"required": ["visualStageEvidenceRefs"], "properties": {"visualStageEvidenceRefs": {"required": ["V5"]}}}},
    {
      "if": {
        "anyOf": [
          {"required": ["globalStaticBaselineState"]},
          {"required": ["visualStageModel", "visualStage", "visualStageState"], "properties": {"visualStage": {"const": "V2"}, "visualStageState": {"const": "global-static-baseline-frozen"}}}
        ]
      },
      "then": {"required": ["globalVisualBaselineSelectionRef"]}
    },
    {"if": {"required": ["visualStage"], "properties": {"visualStage": {"const": "V2"}}}, "then": {"properties": {"visualStageState": {"enum": ["not-started", "in-progress", "pending", "failed", "stale", "invalid", "global-static-baseline-frozen"]}}}},
    {"if": {"required": ["visualStage"], "properties": {"visualStage": {"enum": ["V0", "V1"]}}}, "then": {"not": {"required": ["globalStaticBaselineState"]}, "properties": {"visualStageState": {"enum": ["not-started", "in-progress", "pending", "failed", "stale", "invalid"]}}}},
    {"if": {"properties": {"visualStage": {"const": "V3"}}}, "then": {"properties": {"visualStageState": {"enum": ["not-started", "in-progress", "pending", "failed", "stale", "invalid", "v3-production-planning-complete"]}}}},
    {"if": {"properties": {"visualStage": {"const": "V4"}}}, "then": {"properties": {"visualStageState": {"enum": ["not-started", "in-progress", "pending", "failed", "stale", "invalid", "v4-formal-acceptance-complete"]}}}},
    {"if": {"properties": {"visualStage": {"const": "V5"}}}, "then": {"properties": {"visualStageState": {"enum": ["not-started", "in-progress", "pending", "failed", "stale", "invalid", "v5-runtime-integration-candidate"]}}}}
  ]
}
