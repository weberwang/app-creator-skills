{
  "schemaVersion": "1.0",
  "templateVersion": "cocos-game-1.0",
  "stack": "cocos",
  "project": {
    "entryPoints": ["assets/scripts/foundation/CompositionRoot.ts"],
    "directories": {
      "foundation": "assets/scripts/foundation",
      "shared": "assets/scripts/shared",
      "scenes": "assets/scripts/scenes/<场景ID>",
      "displayLayers": "assets/scripts/display-layers/<显示层ID>"
    },
    "lifecycle": "唯一启动入口装配公共服务；场景和显示层分别管理创建、订阅、退出与资源释放。"
  },
  "display": {
    "contentRoot": "ContentRoot",
    "screenHost": "Canvas",
    "host": "当前 Scene 的世界节点与持久 Canvas；Camera 层序在项目内统一配置",
    "layers": [
      {"id":"content","mount":"当前 Scene 的世界根；二维渲染节点挂在 RenderRoot2D 下","owner":"当前场景","input":"接收未被上层消费的游戏输入","cleanup":"退出时清理场景专属节点与订阅","optional":false},
      {"id":"hud","mount":"Canvas/HudLayer","owner":"当前场景","input":"控件消费自身命中","cleanup":"随宿主退出卸载","optional":true},
      {"id":"popups","mount":"Canvas/PopupLayer","owner":"公共弹窗服务","input":"模态弹窗隔离下层输入并恢复焦点","cleanup":"关闭时销毁 Prefab 实例并清理业务活动","optional":false},
      {"id":"toasts","mount":"Canvas/ToastLayer","owner":"公共提示服务","input":"不阻断输入或抢焦点","cleanup":"展示结束后回收空闲实例","optional":true},
      {"id":"loading","mount":"Canvas/LoadingLayer","owner":"统一加载服务","input":"前台阻塞期间隔离下层输入","cleanup":"关联任务和令牌完成后隐藏","optional":false}
    ]
  }
}
