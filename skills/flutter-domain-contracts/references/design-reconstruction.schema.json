{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flutter 已确认目标驱动的 V3 设计拆解与生产规格",
  "description": "冻结 V3 计划；V4 实际生产与 V5 对照另存领域封套，不要求 V3 提前生产图片。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workItemId", "objectId", "candidateId", "referenceTarget", "conditions", "elements", "implementations"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "workItemId": {"$ref": "#/$defs/text"}, "objectId": {"$ref": "#/$defs/text"}, "candidateId": {"$ref": "#/$defs/text"},
    "hostId": {"$ref": "#/$defs/text"}, "layerType": {"enum": ["modal", "popup", "drawer", "toast"]},
    "referenceTarget": {"$ref": "#/$defs/ref"},
    "conditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}},
    "elements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/element"}},
    "implementations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/implementation"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "size": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}},
    "lineSize": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "number", "exclusiveMinimum": 0}, "height": {"const": 0}}},
    "insets": {"type": "object", "additionalProperties": false, "required": ["top", "right", "bottom", "left"], "properties": {"top": {"type": "number", "minimum": 0}, "right": {"type": "number", "minimum": 0}, "bottom": {"type": "number", "minimum": 0}, "left": {"type": "number", "minimum": 0}}},
    "region": {"type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height", "unit"], "properties": {"x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}, "unit": {"const": "px"}, "frame": {"$ref": "#/$defs/text"}}},
    "condition": {"type": "object", "additionalProperties": false, "required": ["id", "stateId", "viewport", "language", "textScale", "adaptation"], "properties": {
      "id": {"$ref": "#/$defs/text"}, "stateId": {"$ref": "#/$defs/text"}, "viewport": {"$ref": "#/$defs/size"}, "targetRef": {"$ref": "#/$defs/ref"},
      "language": {"$ref": "#/$defs/text"}, "textScale": {"type": "number", "exclusiveMinimum": 0},
      "adaptation": {"type": "object", "additionalProperties": false, "required": ["platform", "orientation", "safeArea", "keyboard"], "properties": {"platform": {"$ref": "#/$defs/text"}, "orientation": {"enum": ["portrait", "landscape"]}, "safeArea": {"$ref": "#/$defs/insets"}, "keyboard": {"enum": ["shown", "hidden", "not-applicable"]}}}
    }},
    "element": {"type": "object", "additionalProperties": false, "required": ["id", "label", "targetRef", "region", "conditionIds", "parentId", "layoutReference", "implementationId"], "properties": {
      "id": {"$ref": "#/$defs/text"}, "label": {"$ref": "#/$defs/text"}, "targetRef": {"$ref": "#/$defs/ref"}, "region": {"$ref": "#/$defs/region"},
      "conditionIds": {"$ref": "#/$defs/ids"}, "parentId": {"type": ["string", "null"], "minLength": 1}, "layoutReference": {"$ref": "#/$defs/text"}, "implementationId": {"$ref": "#/$defs/text"}
    }},
    "requirement": {"type": "object", "additionalProperties": false, "required": ["value", "basis", "reason"], "properties": {
      "value": {"oneOf": [{"type": "string", "minLength": 1, "pattern": "\\S"}, {"type": "number"}, {"type": "boolean"}, {"type": "object", "minProperties": 1}, {"type": "array", "minItems": 1}]},
      "basis": {"enum": ["measured", "estimated", "adaptation", "approved-change"]}, "reason": {"$ref": "#/$defs/text"}, "approvalRef": {"$ref": "#/$defs/ref"}
    }, "allOf": [{"if": {"properties": {"basis": {"const": "approved-change"}}, "required": ["basis"]}, "then": {"required": ["approvalRef"]}, "else": {"not": {"required": ["approvalRef"]}}}]},
    "requirements": {"type": "object", "additionalProperties": false, "required": ["structure", "size", "spacing", "typography", "color", "border", "shape", "appearance", "states"], "properties": {
      "structure": {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"value": {"type": "object", "additionalProperties": false, "required": ["widget", "layout", "children"], "properties": {"widget": {"$ref": "#/$defs/text"}, "layout": {"$ref": "#/$defs/text"}, "children": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}}}}}]},
      "size": {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"value": {"oneOf": [{"$ref": "#/$defs/size"}, {"$ref": "#/$defs/lineSize"}]}}}]},
      "spacing": {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"value": {"oneOf": [{"$ref": "#/$defs/notApplicable"}, {"$ref": "#/$defs/insets"}]}}}]},
      "typography": {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"value": {"oneOf": [{"$ref": "#/$defs/notApplicable"}, {"$ref": "#/$defs/typography"}]}}}]},
      "color": {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"value": {"oneOf": [{"$ref": "#/$defs/notApplicable"}, {"type": "object", "additionalProperties": false, "required": ["background", "foreground"], "properties": {"background": {"$ref": "#/$defs/text"}, "foreground": {"$ref": "#/$defs/text"}}}]}}}]},
      "border": {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"value": {"oneOf": [{"$ref": "#/$defs/notApplicable"}, {"type": "object", "additionalProperties": false, "required": ["width", "color"], "properties": {"width": {"type": "number", "minimum": 0}, "color": {"$ref": "#/$defs/text"}}}]}}}]},
      "shape": {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"value": {"$ref": "#/$defs/shape"}}}]},
      "appearance": {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"value": {"$ref": "#/$defs/appearance"}}}]},
      "touchTarget": {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"value": {"type": "object", "additionalProperties": false, "required": ["nodeId", "width", "height", "unit"], "properties": {"nodeId": {"$ref": "#/$defs/text"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}, "unit": {"const": "logical-px"}}}}}]},
      "states": {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"value": {"type": "object", "additionalProperties": false, "required": ["ids", "rules"], "properties": {"ids": {"$ref": "#/$defs/ids"}, "rules": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/text"}}}}}}]}
    }, "allOf": [{"if": {"properties": {"shape": {"properties": {"value": {"properties": {"kind": {"const": "line"}}, "required": ["kind"]}}, "required": ["value"]}}, "required": ["shape"]}, "then": {"properties": {"size": {"properties": {"value": {"$ref": "#/$defs/lineSize"}}}}}, "else": {"properties": {"size": {"properties": {"value": {"$ref": "#/$defs/size"}}}}}}]},
    "logicalLength": {"type": "object", "additionalProperties": false, "required": ["value", "unit"], "properties": {"value": {"type": "number"}, "unit": {"const": "logical-px"}}},
    "typography": {"type": "object", "additionalProperties": false, "required": ["family", "size", "weight", "lineHeight", "letterSpacing"], "properties": {
      "family": {"$ref": "#/$defs/text"}, "size": {"$ref": "#/$defs/logicalLength"}, "weight": {"type": "integer", "minimum": 1, "maximum": 1000},
      "lineHeight": {"type": "object", "additionalProperties": false, "required": ["sourceUnit", "sourceValue", "flutterHeight"], "properties": {"sourceUnit": {"enum": ["PIXELS", "PERCENT", "AUTO"]}, "sourceValue": {"type": ["number", "null"]}, "flutterHeight": {"type": ["number", "null"]}}, "allOf": [{"if": {"properties": {"sourceUnit": {"const": "AUTO"}}}, "then": {"properties": {"sourceValue": {"type": "null"}, "flutterHeight": {"type": "null"}}}, "else": {"properties": {"sourceValue": {"type": "number", "exclusiveMinimum": 0}, "flutterHeight": {"type": "number", "exclusiveMinimum": 0}}}}]},
      "letterSpacing": {"type": "object", "additionalProperties": false, "required": ["sourceUnit", "sourceValue", "value", "unit"], "properties": {"sourceUnit": {"enum": ["PIXELS", "PERCENT"]}, "sourceValue": {"type": "number"}, "value": {"type": "number"}, "unit": {"const": "logical-px"}}}
    }},
    "cornerValues": {"type": "object", "required": ["topLeft", "topRight", "bottomRight", "bottomLeft"], "properties": {"topLeft": {"type": "number", "minimum": 0}, "topRight": {"type": "number", "minimum": 0}, "bottomRight": {"type": "number", "minimum": 0}, "bottomLeft": {"type": "number", "minimum": 0}}},
    "shape": {"type": "object", "additionalProperties": false, "required": ["kind", "flutter"], "properties": {
      "kind": {"enum": ["rectangle", "roundedRectangle", "roundRectangle", "rounded-rectangle", "ellipse", "line", "path", "capsule", "text"]},
      "corners": {"allOf": [{"$ref": "#/$defs/cornerValues"}, {"type": "object", "additionalProperties": false, "required": ["topLeft", "topRight", "bottomRight", "bottomLeft", "unit"], "properties": {"topLeft": {"type": "number", "minimum": 0}, "topRight": {"type": "number", "minimum": 0}, "bottomRight": {"type": "number", "minimum": 0}, "bottomLeft": {"type": "number", "minimum": 0}, "unit": {"const": "logical-px"}}}]},
      "flutter": {"oneOf": [
        {"allOf": [{"$ref": "#/$defs/cornerValues"}, {"type": "object", "additionalProperties": false, "required": ["constructor", "topLeft", "topRight", "bottomRight", "bottomLeft"], "properties": {"constructor": {"const": "BorderRadius.only"}, "topLeft": {"type": "number", "minimum": 0}, "topRight": {"type": "number", "minimum": 0}, "bottomRight": {"type": "number", "minimum": 0}, "bottomLeft": {"type": "number", "minimum": 0}}}]},
        {"type": "object", "additionalProperties": false, "required": ["constructor"], "properties": {"constructor": {"enum": ["ClipOval", "Text"]}}},
        {"type": "object", "additionalProperties": false, "required": ["constructor", "geometry"], "properties": {"constructor": {"const": "CustomPaint"}, "geometry": {"type": "object", "minProperties": 1}}}
      ]}
    }, "allOf": [
      {"if": {"properties": {"kind": {"enum": ["rectangle", "roundedRectangle", "roundRectangle", "rounded-rectangle", "capsule"]}}}, "then": {"required": ["corners"], "properties": {"flutter": {"properties": {"constructor": {"const": "BorderRadius.only"}}}}}},
      {"if": {"properties": {"kind": {"const": "ellipse"}}}, "then": {"not": {"required": ["corners"]}, "properties": {"flutter": {"properties": {"constructor": {"const": "ClipOval"}}}}}},
      {"if": {"properties": {"kind": {"enum": ["line", "path"]}}}, "then": {"not": {"required": ["corners"]}, "properties": {"flutter": {"properties": {"constructor": {"const": "CustomPaint"}}}}}},
      {"if": {"properties": {"kind": {"const": "text"}}}, "then": {"not": {"required": ["corners"]}, "properties": {"flutter": {"properties": {"constructor": {"const": "Text"}}}}}}
    ]},
    "matrix": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}},
    "normalizedPaint": {"type": "object", "required": ["type"], "properties": {
      "type": {"enum": ["SOLID", "GRADIENT_LINEAR", "GRADIENT_RADIAL", "GRADIENT_ANGULAR", "GRADIENT_DIAMOND", "IMAGE"]},
      "opacity": {"type": "number", "minimum": 0, "maximum": 1}, "color": {"type": "object", "required": ["r", "g", "b"], "properties": {"r": {"type": "number", "minimum": 0, "maximum": 1}, "g": {"type": "number", "minimum": 0, "maximum": 1}, "b": {"type": "number", "minimum": 0, "maximum": 1}, "a": {"type": "number", "minimum": 0, "maximum": 1}}},
      "gradientTransform": {"$ref": "#/$defs/matrix"}, "gradientTransformUnit": {"const": "normalized"},
      "gradientStops": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["position", "color"], "properties": {"position": {"type": "object", "additionalProperties": false, "required": ["value", "unit"], "properties": {"value": {"type": "number", "minimum": 0, "maximum": 1}, "unit": {"const": "ratio"}}}, "color": {"type": "object", "required": ["r", "g", "b"], "properties": {"r": {"type": "number", "minimum": 0, "maximum": 1}, "g": {"type": "number", "minimum": 0, "maximum": 1}, "b": {"type": "number", "minimum": 0, "maximum": 1}, "a": {"type": "number", "minimum": 0, "maximum": 1}}}}}},
      "scaleMode": {"enum": ["FILL", "FIT", "CROP", "TILE"]}, "imageTransform": {"$ref": "#/$defs/matrix"}, "imageTransformUnit": {"const": "normalized"}
    }, "allOf": [{"if": {"properties": {"type": {"enum": ["GRADIENT_LINEAR", "GRADIENT_RADIAL", "GRADIENT_ANGULAR", "GRADIENT_DIAMOND"]}}}, "then": {"required": ["gradientStops"]}}, {"if": {"properties": {"type": {"const": "SOLID"}}}, "then": {"required": ["color"]}}, {"if": {"properties": {"type": {"const": "IMAGE"}}}, "then": {"required": ["scaleMode"], "anyOf": [{"required": ["assetId"]}, {"required": ["imageHash"]}]}}]},
    "normalizedImageFill": {"type": "object", "required": ["scaleMode"], "properties": {"assetId": {"$ref": "#/$defs/text"}, "imageHash": {"$ref": "#/$defs/text"}, "scaleMode": {"enum": ["FILL", "FIT", "CROP", "TILE"]}, "imageTransform": {"$ref": "#/$defs/matrix"}, "imageTransformUnit": {"const": "normalized"}}, "anyOf": [{"required": ["assetId"]}, {"required": ["imageHash"]}], "allOf": [{"if": {"properties": {"scaleMode": {"const": "CROP"}}}, "then": {"required": ["imageTransform"]}}]},
    "normalizedFill": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/text"}, {"$ref": "#/$defs/normalizedPaint"}, {"type": "array", "items": {"$ref": "#/$defs/normalizedPaint"}}]},
    "textPaint": {"oneOf": [
      {"type": "string", "pattern": "^#[0-9A-Fa-f]{8}$"},
      {"allOf": [{"$ref": "#/$defs/normalizedPaint"}, {"anyOf": [
        {"properties": {"type": {"const": "SOLID"}}, "anyOf": [{"required": ["opacity"]}, {"properties": {"color": {"required": ["a"]}}}]},
        {"properties": {"type": {"enum": ["GRADIENT_LINEAR", "GRADIENT_RADIAL", "GRADIENT_ANGULAR", "GRADIENT_DIAMOND"]}, "gradientStops": {"items": {"properties": {"color": {"required": ["a"]}}}}}}
      ]}]}
    ]},
    "appearance": {"type": "object", "additionalProperties": false, "required": ["raw", "normalized"], "properties": {
      "raw": {"type": "object", "additionalProperties": false, "required": ["nodeType", "properties", "font", "fills", "imageFills", "opacity", "strokes", "strokeWeight", "cornerRadius", "rectangleCornerRadii", "cornerRadii", "other", "textVisual"], "properties": {"nodeType": {"$ref": "#/$defs/text"}, "properties": {"type": "object"}, "font": {"type": ["object", "null"]}, "fills": {}, "imageFills": {"type": "array"}, "opacity": {"type": ["number", "null"]}, "strokes": {}, "strokeWeight": {"type": ["number", "null"]}, "cornerRadius": {}, "rectangleCornerRadii": {}, "cornerRadii": {}, "other": {"type": "object"}, "textVisual": {"type": ["object", "null"]}}},
      "normalized": {"type": "object", "additionalProperties": false, "required": ["shape", "typography", "textFill", "textOpacity", "fill", "opacity", "imageFills", "border"], "properties": {"shape": {"$ref": "#/$defs/shape"}, "typography": {"anyOf": [{"$ref": "#/$defs/typography"}, {"type": "null"}]}, "textFill": {"$ref": "#/$defs/normalizedFill"}, "textOpacity": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/opacity"}]}, "fill": {"$ref": "#/$defs/normalizedFill"}, "opacity": {"$ref": "#/$defs/opacity"}, "imageFills": {"type": "array", "items": {"$ref": "#/$defs/normalizedImageFill"}}, "border": {"type": "object", "additionalProperties": false, "required": ["value", "width"], "properties": {"value": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["width", "color"], "properties": {"width": {"type": "number", "minimum": 0}, "color": {"$ref": "#/$defs/text"}}}, {"type": "array", "items": {"$ref": "#/$defs/normalizedPaint"}}]}, "width": {"$ref": "#/$defs/logicalLength"}}}}}
    }, "allOf": [{
      "if": {"anyOf": [
        {"properties": {"raw": {"properties": {"nodeType": {"const": "TEXT"}}}}},
        {"properties": {"raw": {"properties": {"textVisual": {"type": "object"}}}}},
        {"properties": {"normalized": {"properties": {"typography": {"type": "object"}}}}}
      ]},
      "then": {"properties": {"normalized": {"properties": {
        "textFill": {"oneOf": [{"$ref": "#/$defs/textPaint"}, {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/textPaint"}}]},
        "textOpacity": {"$ref": "#/$defs/opacity"}
      }}}}
    }]},
    "opacity": {"type": "object", "additionalProperties": false, "required": ["value", "unit"], "properties": {"value": {"type": "number", "minimum": 0, "maximum": 1}, "unit": {"const": "ratio"}}},
    "notApplicable": {"type": "object", "additionalProperties": false, "required": ["applicable", "reason"], "properties": {"applicable": {"const": false}, "reason": {"$ref": "#/$defs/text"}}},
    "consumer": {"type": "object", "additionalProperties": false, "required": ["id", "sourcePath", "symbol"], "properties": {"id": {"$ref": "#/$defs/text"}, "sourcePath": {"$ref": "#/$defs/text"}, "symbol": {"$ref": "#/$defs/text"}}},
    "production": {"type": "object", "additionalProperties": false, "required": ["identity", "consumerIds", "sourceRegion", "outputPath", "outputSize", "displaySize", "density", "background", "transparentInsets", "edgePolicy"], "properties": {
      "identity": {"enum": ["independent", "shared"]}, "consumerIds": {"$ref": "#/$defs/ids"}, "sourceRegion": {"$ref": "#/$defs/region"},
      "outputPath": {"$ref": "#/$defs/text"}, "outputSize": {"$ref": "#/$defs/size"}, "displaySize": {"$ref": "#/$defs/size"}, "density": {"type": "number", "exclusiveMinimum": 0},
      "background": {"enum": ["transparent", "retained", "opaque"]}, "transparentInsets": {"$ref": "#/$defs/insets"}, "edgePolicy": {"$ref": "#/$defs/text"},
      "effectiveContentBounds": {"$ref": "#/$defs/region"}, "slice": {"$ref": "#/$defs/insets"}, "nineSlice": {"type": "object", "additionalProperties": false, "required": ["minimumSize"], "properties": {"minimumSize": {"$ref": "#/$defs/size"}}}, "frames": {"$ref": "#/$defs/ids"}
    }},
    "implementation": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "designItemIds", "consumers", "designReason", "requirements"], "properties": {
      "id": {"$ref": "#/$defs/text"}, "kind": {"enum": ["native", "image", "shared-image", "dynamic"]}, "designItemIds": {"$ref": "#/$defs/ids"},
      "consumers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/consumer"}}, "designReason": {"$ref": "#/$defs/text"},
      "requirements": {"$ref": "#/$defs/requirements"}, "production": {"$ref": "#/$defs/production"},
      "sourceAssets": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "role", "nodeIds", "sourceRef"], "properties": {"id": {"$ref": "#/$defs/text"}, "role": {"enum": ["illustration", "photo", "icon", "texture", "character"]}, "nodeIds": {"$ref": "#/$defs/ids"}, "sourceRef": {"$ref": "#/$defs/ref"}}}}
    }, "allOf": [{"if": {"properties": {"kind": {"enum": ["image", "shared-image"]}}, "required": ["kind"]}, "then": {"required": ["production"]}, "else": {"not": {"required": ["production"]}}}]}
  }
}
