{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flutter 已确认目标驱动的 V3 设计拆解与生产规格",
  "description": "冻结 V3 计划；V4 实际生产与 V5 对照另存领域封套，不要求 V3 提前生产图片。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workItemId", "objectId", "candidateId", "referenceTarget", "conditions", "elements", "implementations"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "workItemId": {"$ref": "#/$defs/text"}, "objectId": {"$ref": "#/$defs/text"}, "candidateId": {"$ref": "#/$defs/text"},
    "hostId": {"$ref": "#/$defs/text"}, "layerType": {"enum": ["modal", "popup", "drawer", "toast"]},
    "referenceTarget": {"$ref": "#/$defs/ref"},
    "conditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}},
    "elements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/element"}},
    "implementations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/implementation"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "size": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}},
    "insets": {"type": "object", "additionalProperties": false, "required": ["top", "right", "bottom", "left"], "properties": {"top": {"type": "number", "minimum": 0}, "right": {"type": "number", "minimum": 0}, "bottom": {"type": "number", "minimum": 0}, "left": {"type": "number", "minimum": 0}}},
    "region": {"type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height", "unit"], "properties": {"x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}, "unit": {"const": "px"}, "frame": {"$ref": "#/$defs/text"}}},
    "condition": {"type": "object", "additionalProperties": false, "required": ["id", "stateId", "viewport", "language", "textScale", "adaptation"], "properties": {
      "id": {"$ref": "#/$defs/text"}, "stateId": {"$ref": "#/$defs/text"}, "viewport": {"$ref": "#/$defs/size"}, "targetRef": {"$ref": "#/$defs/ref"},
      "language": {"$ref": "#/$defs/text"}, "textScale": {"type": "number", "exclusiveMinimum": 0},
      "adaptation": {"type": "object", "additionalProperties": false, "required": ["platform", "orientation", "safeArea", "keyboard"], "properties": {"platform": {"$ref": "#/$defs/text"}, "orientation": {"enum": ["portrait", "landscape"]}, "safeArea": {"$ref": "#/$defs/insets"}, "keyboard": {"enum": ["shown", "hidden", "not-applicable"]}}}
    }},
    "element": {"type": "object", "additionalProperties": false, "required": ["id", "label", "targetRef", "region", "conditionIds", "parentId", "layoutReference", "implementationId"], "properties": {
      "id": {"$ref": "#/$defs/text"}, "label": {"$ref": "#/$defs/text"}, "targetRef": {"$ref": "#/$defs/ref"}, "region": {"$ref": "#/$defs/region"},
      "conditionIds": {"$ref": "#/$defs/ids"}, "parentId": {"type": ["string", "null"], "minLength": 1}, "layoutReference": {"$ref": "#/$defs/text"}, "implementationId": {"$ref": "#/$defs/text"}
    }},
    "requirement": {"type": "object", "additionalProperties": false, "required": ["value", "basis", "reason"], "properties": {
      "value": {"oneOf": [{"type": "string", "minLength": 1, "pattern": "\\S"}, {"type": "number"}, {"type": "boolean"}, {"type": "object", "minProperties": 1}, {"type": "array", "minItems": 1}]},
      "basis": {"enum": ["measured", "estimated", "adaptation", "approved-change"]}, "reason": {"$ref": "#/$defs/text"}, "approvalRef": {"$ref": "#/$defs/ref"}
    }, "allOf": [{"if": {"properties": {"basis": {"const": "approved-change"}}, "required": ["basis"]}, "then": {"required": ["approvalRef"]}, "else": {"not": {"required": ["approvalRef"]}}}]},
    "requirements": {"type": "object", "additionalProperties": false, "required": ["structure", "size", "spacing", "typography", "color", "border", "shape", "states"], "properties": {
      "structure": {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"value": {"type": "object", "additionalProperties": false, "required": ["widget", "layout", "children"], "properties": {"widget": {"$ref": "#/$defs/text"}, "layout": {"$ref": "#/$defs/text"}, "children": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}}}}}]},
      "size": {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"value": {"$ref": "#/$defs/size"}}}]},
      "spacing": {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"value": {"$ref": "#/$defs/insets"}}}]},
      "typography": {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"value": {"oneOf": [{"$ref": "#/$defs/notApplicable"}, {"type": "object", "additionalProperties": false, "required": ["family", "size", "weight", "lineHeight", "letterSpacing"], "properties": {"family": {"$ref": "#/$defs/text"}, "size": {"type": "number", "exclusiveMinimum": 0}, "weight": {"type": "integer", "minimum": 1, "maximum": 1000}, "lineHeight": {"type": "number", "exclusiveMinimum": 0}, "letterSpacing": {"type": "number"}}}]}}}]},
      "color": {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"value": {"type": "object", "additionalProperties": false, "required": ["background", "foreground"], "properties": {"background": {"$ref": "#/$defs/text"}, "foreground": {"$ref": "#/$defs/text"}}}}}]},
      "border": {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"value": {"oneOf": [{"$ref": "#/$defs/notApplicable"}, {"type": "object", "additionalProperties": false, "required": ["width", "color"], "properties": {"width": {"type": "number", "minimum": 0}, "color": {"$ref": "#/$defs/text"}}}]}}}]},
      "shape": {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"value": {"type": "object", "additionalProperties": false, "required": ["kind", "radius"], "properties": {"kind": {"$ref": "#/$defs/text"}, "radius": {"type": "number", "minimum": 0}}}}}]},
      "states": {"allOf": [{"$ref": "#/$defs/requirement"}, {"properties": {"value": {"type": "object", "additionalProperties": false, "required": ["ids", "rules"], "properties": {"ids": {"$ref": "#/$defs/ids"}, "rules": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/text"}}}}}}]}
    }},
    "notApplicable": {"type": "object", "additionalProperties": false, "required": ["applicable", "reason"], "properties": {"applicable": {"const": false}, "reason": {"$ref": "#/$defs/text"}}},
    "consumer": {"type": "object", "additionalProperties": false, "required": ["id", "sourcePath", "symbol"], "properties": {"id": {"$ref": "#/$defs/text"}, "sourcePath": {"$ref": "#/$defs/text"}, "symbol": {"$ref": "#/$defs/text"}}},
    "production": {"type": "object", "additionalProperties": false, "required": ["identity", "consumerIds", "sourceRegion", "outputPath", "outputSize", "displaySize", "density", "background", "transparentInsets", "edgePolicy"], "properties": {
      "identity": {"enum": ["independent", "shared"]}, "consumerIds": {"$ref": "#/$defs/ids"}, "sourceRegion": {"$ref": "#/$defs/region"},
      "outputPath": {"$ref": "#/$defs/text"}, "outputSize": {"$ref": "#/$defs/size"}, "displaySize": {"$ref": "#/$defs/size"}, "density": {"type": "number", "exclusiveMinimum": 0},
      "background": {"enum": ["transparent", "retained", "opaque"]}, "transparentInsets": {"$ref": "#/$defs/insets"}, "edgePolicy": {"$ref": "#/$defs/text"},
      "effectiveContentBounds": {"$ref": "#/$defs/region"}, "slice": {"$ref": "#/$defs/insets"}, "frames": {"$ref": "#/$defs/ids"}
    }},
    "implementation": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "designItemIds", "consumers", "designReason", "requirements"], "properties": {
      "id": {"$ref": "#/$defs/text"}, "kind": {"enum": ["native", "image", "shared-image", "dynamic"]}, "designItemIds": {"$ref": "#/$defs/ids"},
      "consumers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/consumer"}}, "designReason": {"$ref": "#/$defs/text"},
      "requirements": {"$ref": "#/$defs/requirements"}, "production": {"$ref": "#/$defs/production"}
    }, "allOf": [{"if": {"properties": {"kind": {"enum": ["image", "shared-image"]}}, "required": ["kind"]}, "then": {"required": ["production"]}, "else": {"not": {"required": ["production"]}}}]}
  }
}
