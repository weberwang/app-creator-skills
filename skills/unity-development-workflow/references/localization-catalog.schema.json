{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unity 国际化文案配置",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "languages", "defaultLanguage", "entries"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
    "defaultLanguage": {"$ref": "#/$defs/name"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
    "parameter": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locale", "text"],
      "properties": {
        "locale": {"$ref": "#/$defs/name"},
        "text": {"type": "string", "pattern": "\\S"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "parameters", "values"],
      "properties": {
        "key": {"$ref": "#/$defs/name"},
        "parameters": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/parameter"}},
        "values": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/value"}}
      }
    }
  }
}
