    "places",
    "assets",
    "tests",
    "docs",
    "ArtSource"
  ],
  "projectStructure": {
    "scripts": "src/（Script Sync 实际映射）",
    "places": "places/（已保存且回读的正式 Place 快照）",
    "assets": "assets/（本地资源及授权来源）",
    "sourceArt": "ArtSource/（可编辑制作源）",
    "tests": "tests/（实际项目测试入口）",
    "docs": "docs/（产品、技术与验收记录）"
  },
