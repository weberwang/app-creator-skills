{
  "id": "esp32",
  "displayName": "ESP32 设备 GUI",
  "detectAny": [
    "sdkconfig",
    "sdkconfig.defaults",
    "main/idf_component.yml",
    "platformio.ini"
  ],
  "frameworkPolicy": [
    "优先核实板卡、芯片、屏幕和输入；通用CMake或平台文件不能单独证明ESP32目标。",
    "默认评估 ESP-IDF + LVGL，实际SDK、GUI、BSP和移植组件版本以项目为准，不自动迁移已有明确技术选择。",
    "设备页面使用PAGE，独立瞬态层使用DISPLAY_LAYER，驱动/业务/通信使用MODULE，不使用SCENE。"
  ],
  "nativeRules": [
    "原生GUI按实际屏幕像素、LVGL父子布局和输入所有权实现，不套用Web DPR或Flutter布局语义。",
    "GUI调用遵循唯一线程/锁策略；异步刷新完成后才能回收或复用对应缓冲。",
    "字体、图片与缓冲在已声明的Flash/RAM/PSRAM预算内转换、注册和验证，不假设所有硬件具有PSRAM或图片解码器。",
    "复用工程实际构建与测试入口，主机模拟和设备运行分开记录；真机、烧录、擦除和OTA需对应明确授权。",
    "V2-V5执行独立ESP32领域证据合同，默认由用户人工检查截图，技术检查不代替视觉验收。"
  ],
  "evidenceRequirements": {
    "engineering": [
      "build",
      "tests"
    ],
    "visual": [
      "layout",
      "navigation",
      "resource-budget"
    ],
    "assetImport": [
      "asset-registration"
    ]
  },
  "runtimeRoots": [
    "main",
    "components",
    "include",
    "src",
    "test",
    "tests",
    "host",
    "simulator",
    "assets",
