    "Kconfig.projbuild",
    "CMakePresets.json"
  ],
  "projectStructure": {
    "source": "main/ 与 components/（按实际工程）",
    "screens": "components/ui/（页面与共享控件）",
    "tests": "test/ 或 tests/；host/ 或 simulator/（已有时）",
    "assets": "assets/ 与生成资源的注册目录",
    "designAssets": "assets-source/（正式制作源）"
  },
  "resourceDirectories": [
